<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Existing permissions — unchanged -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        READ_EXTERNAL_STORAGE: needed on API 28 and below to access the model
        file written to getExternalFilesDir(). On API 29+ Android grants access
        to your own app's external files directory without this permission.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VisionQA"
        android:largeHeap="true">
        <!--
            largeHeap="true" is important — Gemma 4 E2B loads ~2.5GB of weights.
            Without this, the JVM heap limit (~256MB default) causes OOM before
            MediaPipe even gets to the model. The native heap (where model weights
            actually live) is unlimited, but largeHeap raises the Java heap ceiling
            so the rest of the app has headroom while the model is running.
        -->

        <!--
            GPU acceleration via OpenCL.
            required="false" so the app still installs on devices without OpenCL
            (MediaPipe falls back to CPU automatically).
            On iQOO Neo 9 Pro (Adreno 740) both libraries are present and allow
            full GPU delegation.
        -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>